{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tap nhan cua du an (label schema)",
  "description": "Loai du lieu + danh sach cong cu gan nhan. Kiem HINH DANG o day; luat ngu nghia (ten cong cu khong trung, cong cu hop voi loai du lieu, ten lop khong trung, spanTool tro dung cong cu span...) kiem trong code Crowd.Labeling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["modality", "tools"],
  "properties": {
    "modality": { "enum": ["image", "text", "audio", "video", "pair", "list"] },
    "segmentSeconds": {
      "description": "Chi audio/video: cat file dai thanh doan N giay, moi doan la mot task.",
      "type": "integer", "minimum": 5, "maximum": 3600
    },
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tenLop": { "type": "string", "minLength": 1, "maxLength": 50 },
    "tenKhoa": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "attribute": {
      "description": "Thuoc tinh cua TUNG doi tuong (khung, da giac, doan...). Vd {\"name\":\"che_khuat\",\"type\":\"boolean\"}; OCR = khung + thuoc tinh text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/tenKhoa" },
        "type": { "enum": ["choice", "boolean", "text", "number"] },
        "options": { "type": "array", "minItems": 2, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/tenLop" } },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["options"] },
          "else": { "properties": { "options": false } }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "else": { "properties": { "maxLength": false } }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/tenKhoa" },
        "kind": {
          "enum": [
            "classification", "bbox", "polygon", "span", "transcription", "temporalSegment", "pairwise",
            "freeText", "number", "keypoint", "polyline", "mask", "track", "relation", "ranking"
          ]
        },
        "classes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/tenLop" } },
        "allowMultiple": { "type": "boolean" },
        "required": { "type": "boolean" },
        "minItems": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "allowTie": { "type": "boolean" },
        "matchThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "attributes": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/attribute" } },
        "spanTool": { "$ref": "#/$defs/tenKhoa" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "integer": { "type": "boolean" },
        "tolerance": { "type": "number", "minimum": 0 },
        "rotatable": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "bbox" } } },
          "else": { "properties": { "rotatable": false } }
        },
        {
          "if": { "properties": { "kind": { "const": "classification" } } },
          "then": {
            "required": ["classes"],
            "properties": {
              "classes": { "minItems": 2 }, "minItems": false, "maxItems": false, "maxLength": false, "allowTie": false, "matchThreshold": false,
              "attributes": false, "spanTool": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["bbox", "polygon", "span", "temporalSegment", "keypoint", "polyline", "mask", "track"] } } },
          "then": {
            "required": ["classes"],
            "properties": {
              "allowMultiple": false, "maxLength": false, "allowTie": false,
              "spanTool": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "relation" } } },
          "then": {
            "required": ["classes", "spanTool"],
            "properties": {
              "allowMultiple": false, "maxLength": false, "allowTie": false,
              "attributes": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "transcription" } } },
          "then": {
            "properties": {
              "classes": false, "allowMultiple": false, "minItems": false, "maxItems": false, "allowTie": false,
              "attributes": false, "spanTool": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "freeText" } } },
          "then": {
            "properties": {
              "classes": false, "allowMultiple": false, "minItems": false, "maxItems": false, "allowTie": false, "matchThreshold": false,
              "attributes": false, "spanTool": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "pairwise" } } },
          "then": {
            "properties": {
              "classes": false, "allowMultiple": false, "minItems": false, "maxItems": false, "maxLength": false, "matchThreshold": false,
              "attributes": false, "spanTool": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "number" } } },
          "then": {
            "properties": {
              "classes": false, "allowMultiple": false, "minItems": false, "maxItems": false, "maxLength": false, "allowTie": false,
              "matchThreshold": false, "attributes": false, "spanTool": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "ranking" } } },
          "then": {
            "properties": {
              "classes": false, "allowMultiple": false, "minItems": false, "maxItems": false, "maxLength": false, "allowTie": false,
              "attributes": false, "spanTool": false, "min": false, "max": false, "integer": false, "tolerance": false
            }
          }
        }
      ]
    }
  }
}
