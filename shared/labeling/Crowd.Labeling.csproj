<Project Sdk="Microsoft.NET.Sdk">

  <!-- DINH DANG NHAN dung chung — "ngon ngu chung" ve nhan giua project-svc,
       task-svc, annotation-svc va hop dong event.

       Mo hinh: LOAI DU LIEU (image, text, audio, video, pair) x CONG CU gan nhan
       (classification, bbox, polygon, span, transcription, temporalSegment,
       pairwise). Tap nhan cua du an = mot loai du lieu + danh sach cong cu.

       Hai lop kiem:
         1. HINH DANG bang JSON Schema — file goc o contracts/labeling, nhung vao
            assembly duoi dang tai nguyen. Python (quality-svc) doc CUNG file.
         2. NGU NGHIA bang code — khung nam trong anh, doan van nam trong van ban,
            lop co trong tap nhan...

       Them cong cu moi = them mot file schema + mot lop IToolKind. KHONG doi
       bang, KHONG doi event. -->

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\contracts\labeling\label-schema.schema.json" LogicalName="schemas/label-schema.schema.json" />
    <EmbeddedResource Include="..\..\contracts\labeling\tools\*.result.schema.json" LogicalName="schemas/tools/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
