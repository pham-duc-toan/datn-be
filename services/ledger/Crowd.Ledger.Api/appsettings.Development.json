{
  "Seed": {
    "Enabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "LedgerDb": "Host=localhost;Port=5405;Database=ledger_db;Username=ledger_user;Password=dev_ledger_pw;Maximum Pool Size=20"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "datn",
    "Password": "dev_rabbit_pw",
    "VirtualHost": "/",
    "Exchange": "datn.events"
  },

  "Outbox": {
    "PollInterval": "00:00:00.500",
    "BatchSize": 50,
    "PublishTimeout": "00:00:10"
  },

  "Consumers": {
    "PrefetchCount": 10,
    "DeliveryLimit": 5,
    "DeadLetterExchange": "datn.dlx"
  },

  "Ledger": {
    // Dev: treo 2 phut de test duoc luong rut tien ngay. Production giu mac
    // dinh 3 ngay cua LedgerOptions (thoi gian cho doi soat / khieu nai).
    "ThoiGianTreo": "00:02:00",
    "ChuKyGiaiPhong": "00:00:30",
    "RutToiThieuVnd": 50000
  },

  "Auth": {
    "Issuer": "crowd-identity",
    "Audience": "crowd-api",
    "MetadataAddress": "http://localhost:8101/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  }
}
