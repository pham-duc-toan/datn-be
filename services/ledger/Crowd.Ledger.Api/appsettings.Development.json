{
  "Seed": {
    "Enabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "LedgerDb": "Host=localhost;Port=5405;Database=ledger_db;Username=ledger_user;Password=dev_ledger_pw;Maximum Pool Size=20",
    "SettingsRead": "Host=localhost;Port=5411;Database=admin_db;Username=settings_reader;Password=dev_reader_settings_pw;Maximum Pool Size=3",
    "LinkRead": "Host=localhost;Port=5407;Database=link_db;Username=ledger_reader;Password=dev_reader_ledger_pw;Maximum Pool Size=3"
  },

  "ReadAccess": {
    "Readers": {
      "gate_reader": "dev_reader_gate_pw"
    }
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "datn",
    "Password": "dev_rabbit_pw",
    "VirtualHost": "/",
    "Exchange": "datn.events"
  },

  "InternalApi": {
    "Key": "dev_internal_key",
    "IdentityUrl": "http://localhost:8101",
    "ProjectGrpcUrl": "http://localhost:9102",
    "TimeoutSeconds": 10
  },

  "Consumers": {
    "DeliveryLimit": 5,
    "DeadLetterExchange": "datn.dlx"
  },

  "Auth": {
    "Issuer": "crowd-identity",
    "Audience": "crowd-api",
    "MetadataAddress": "http://localhost:8101/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  }
}
