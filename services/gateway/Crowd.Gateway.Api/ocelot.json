{
  "Routes": [
    {
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": ["Post"],
      "DownstreamPathTemplate": "/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8101 }]
    },
    {
      //endpoint của gateway nhận được
      "UpstreamPathTemplate": "/me",
      "UpstreamHttpMethod": ["Get"],
      //endpoint của gateway chuyển tới
      "DownstreamPathTemplate": "/me",
      "DownstreamScheme": "http",
      // địa chỉ của service chuyển tới
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8101 }]
    },
    {
      // identity-svc: ho so, ky nang, anh dai dien, doi mat khau, xac thuc email, cap do (/me/...).
      "UpstreamPathTemplate": "/me/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put"],
      "DownstreamPathTemplate": "/me/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8101 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // project-svc. Kiểm token NGAY Ở GATEWAY (lớp 1): token rác bị chặn ở biên,
      // không đi sâu vào trong. project-svc VẪN tự kiểm lại (lớp 2, VD-S-06).
      "UpstreamPathTemplate": "/projects",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/projects",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8102 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      "UpstreamPathTemplate": "/projects/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete"],
      "DownstreamPathTemplate": "/projects/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8102 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // task-svc: mọi endpoint nằm dưới /tasks nên chỉ cần MỘT route.
      "UpstreamPathTemplate": "/tasks/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put"],
      "DownstreamPathTemplate": "/tasks/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8103 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] },
      // IP that cua labeler (chong gian lan FM-07: nhieu tai khoan chung IP). X-Device-Id tu frontend di thang.
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" }
    },
    {
      // link-svc: link rút gọn của người chia sẻ. KHÔNG chặn token ở gateway: API key (FS-05),
      // Quick Link (FS-02) và nút báo cáo của khách vãng lai không có token — service tự kiểm.
      "UpstreamPathTemplate": "/links/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete"],
      "DownstreamPathTemplate": "/links/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8107 }],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" }
    },
    {
      "UpstreamPathTemplate": "/links",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/links",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8107 }],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" }
    },
    {
      // gate-svc: trang vượt link (công khai) + mở link đích. IP thật của khách qua X-Forwarded-For
      // (chống trùng IP 24h, chống tự vượt).
      "UpstreamPathTemplate": "/g/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/g/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8108 }],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" }
    },
    {
      "UpstreamPathTemplate": "/go/{everything}",
      "UpstreamHttpMethod": ["Get"],
      "DownstreamPathTemplate": "/go/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8108 }],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" }
    },
    {
      // media-svc: xem file mẫu qua token trong URL (thẻ <img> không gửi được Authorization).
      // Token mã hoá AES-GCM, sống 5 phút, gắn người xem — chính nó là quyền xem (FP-02/03, FP-06).
      // Timeout 600 s: lần đầu mở video / âm thanh có watermark, media-svc mã hoá lại cả file (sau đó lấy từ bộ đệm).
      "UpstreamPathTemplate": "/media/v/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/media/v/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8109 }],
      "Timeout": 600,
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" }
    },
    {
      // media-svc: nhật ký lượt xem, giải mã watermark, trạng thái che PII — chỉ admin (service tự kiểm vai trò).
      "UpstreamPathTemplate": "/media/admin/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/media/admin/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8109 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // gate-svc: thống kê cho người chia sẻ (FS-07).
      "UpstreamPathTemplate": "/gate/{everything}",
      "UpstreamHttpMethod": ["Get"],
      "DownstreamPathTemplate": "/gate/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8108 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // admin-svc: setting hệ thống (/admin/settings...). Chỉ admin — service tự kiểm vai trò.
      "UpstreamPathTemplate": "/admin/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put"],
      "DownstreamPathTemplate": "/admin/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8111 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // admin-svc: danh mục mẫu bài toán (FM-03) cho mọi người đăng nhập — doanh nghiệp chọn khi tạo dự án.
      "UpstreamPathTemplate": "/templates",
      "UpstreamHttpMethod": ["Get"],
      "DownstreamPathTemplate": "/templates",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8111 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      "UpstreamPathTemplate": "/templates/{everything}",
      "UpstreamHttpMethod": ["Get"],
      "DownstreamPathTemplate": "/templates/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8111 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // identity-svc: xác minh doanh nghiệp (KYB) — doanh nghiệp nộp hồ sơ, admin duyệt (/kyb/admin...).
      // Không đặt dưới /admin vì /admin/* thuộc admin-svc.
      "UpstreamPathTemplate": "/kyb/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put"],
      "DownstreamPathTemplate": "/kyb/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8101 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // identity-svc: admin quản lý tài khoản (FM-01); hồ sơ công khai, bảng xếp hạng (FL-12).
      "UpstreamPathTemplate": "/users/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8101 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // notification-svc: WebSocket thông báo realtime. Trình duyệt không gửi được Authorization khi mở
      // WebSocket → không xác thực ở gateway; vé dùng một lần (?ticket=, xin qua /notifications/me/realtime-ticket)
      // do notification-svc kiểm. Priority cao hơn route /notifications/{everything} (có JWT).
      "UpstreamPathTemplate": "/notifications/realtime",
      "UpstreamHttpMethod": ["Get"],
      "DownstreamPathTemplate": "/notifications/realtime",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8110 }],
      "Priority": 2
    },
    {
      // notification-svc: thông báo trong ứng dụng + tuỳ chọn email (FC-06).
      "UpstreamPathTemplate": "/notifications/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put"],
      "DownstreamPathTemplate": "/notifications/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8110 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // quality-svc (Python): chỉ số đồng thuận, độ tin cậy labeler, uy tín.
      "UpstreamPathTemplate": "/quality/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/quality/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8201 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // annotation-svc: duyệt nhãn, khiếu nại, kết quả, xuất file.
      "UpstreamPathTemplate": "/annotations/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/annotations/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8104 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // ledger-svc: ví, lịch sử, rút tiền, đối soát.
      "UpstreamPathTemplate": "/ledger/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/ledger/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8105 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] }
    },
    {
      // Webhook / IPN cổng thanh toán: KHÔNG kiểm JWT (cổng không có token của ta),
      // payment-svc kiểm CHỮ KÝ. VNPay gọi IPN bằng GET, MoMo / sandbox bằng POST.
      // Priority cao hơn route /payments/{everything}.
      "UpstreamPathTemplate": "/payments/webhooks/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/payments/webhooks/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8106 }],
      "Priority": 3
    },
    {
      // Trang thanh toán giả lập (chỉ dev) — đóng vai trang của cổng.
      "UpstreamPathTemplate": "/payments/sandbox/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/payments/sandbox/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8106 }],
      "Priority": 3
    },
    {
      "UpstreamPathTemplate": "/payments/{everything}",
      "UpstreamHttpMethod": ["Get", "Post"],
      "DownstreamPathTemplate": "/payments/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 8106 }],
      "AuthenticationOptions": { "AuthenticationProviderKeys": ["Bearer"] },
      // IP that cua doanh nghiep: VNPay bat buoc vnp_IpAddr.
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" },
      "Priority": 1
    }
  ],
  // địa chỉ của gateway
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080"
  }
}
