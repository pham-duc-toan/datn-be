{
  "Seed": {
    "Enabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5410;Database=notification_db;Username=notification_user;Password=dev_notification_pw;Maximum Pool Size=10",
    "SettingsRead": "Host=localhost;Port=5411;Database=admin_db;Username=settings_reader;Password=dev_reader_settings_pw;Maximum Pool Size=3",
    "IdentityRead": "Host=localhost;Port=5401;Database=identity_db;Username=notification_reader;Password=dev_reader_notification_pw;Maximum Pool Size=3"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
