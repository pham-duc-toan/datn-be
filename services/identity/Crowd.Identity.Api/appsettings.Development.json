{
  "Seed": {
    "Enabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5401;Database=identity_db;Username=identity_user;Password=dev_identity_pw;Maximum Pool Size=10"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "datn",
    "Password": "dev_rabbit_pw",
    "VirtualHost": "/",
    "Exchange": "datn.events"
  },

  "JwtIssuer": {
    "Issuer": "crowd-identity",
    "Audience": "crowd-api",
    "SigningKeyPath": "secrets/signing-key.pem"
  },

  "Auth": {
    "Issuer": "crowd-identity",
    "Audience": "crowd-api",
    "MetadataAddress": "http://localhost:8101/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  }
}
