{
  "Seed": {
    "Enabled": true
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "TaskDb": "Host=localhost;Port=5403;Database=task_db;Username=task_user;Password=dev_task_pw;Maximum Pool Size=20"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "datn",
    "Password": "dev_rabbit_pw",
    "VirtualHost": "/",
    "Exchange": "datn.events"
  },

  "Consumers": {
    "DeliveryLimit": 5,
    "DeadLetterExchange": "datn.dlx"
  },

  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "datn",
    "SecretKey": "dev_minio_pw",
    "Bucket": "datasets"
  },

  "InternalApi": {
    "Key": "dev_internal_key"
  },

  "Auth": {
    "Issuer": "crowd-identity",
    "Audience": "crowd-api",
    "MetadataAddress": "http://localhost:8101/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  }
}
